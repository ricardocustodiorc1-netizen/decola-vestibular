        "signature": "decola.assert_student(uuid)",
        "definition": "CREATE OR REPLACE FUNCTION decola.assert_student(p_student uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nBEGIN\n IF NOT EXISTS (\n  SELECT 1 FROM decola.students s\n  JOIN decola.accounts a ON a.id=s.account_id\n  WHERE s.id=p_student AND a.id=auth.uid() AND decola.active_account()\n ) THEN RAISE EXCEPTION 'Resource unavailable' USING ERRCODE='42501'; END IF;\nEND;\n$function$\n",
        "owner_bypassrls": true,
        "security_definer": true
      },
      {
        "acl": [
          "postgres=X/postgres",
          "authenticated=X/postgres"
        ],
        "owner": "postgres",
        "settings": [
          "search_path=\"\""
        ],
        "signature": "decola.active_account()",
        "definition": "CREATE OR REPLACE FUNCTION decola.active_account()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS (\n  SELECT 1 FROM decola.accounts a JOIN auth.users u ON u.id=a.id\n  WHERE a.id=auth.uid() AND NOT a.disabled AND u.email_confirmed_at IS NOT NULL\n   AND u.deleted_at IS NULL AND (u.banned_until IS NULL OR u.banned_until<=statement_timestamp())\n );\n$function$\n",
        "owner_bypassrls": true,
        "security_definer": true
      },
      {
        "acl": [
          "postgres=X/postgres",
          "authenticated=X/postgres"
        ],
        "owner": "postgres",
        "settings": [
          "search_path=\"\""
        ],
        "signature": "decola.request_trial(uuid)",
        "definition": "CREATE OR REPLACE FUNCTION decola.request_trial(p_student uuid)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE v_key text; v_now timestamptz; v_record decola.trial_claims;\nBEGIN\n PERFORM decola.assert_student(p_student);\n SELECT eligibility_key INTO v_key FROM decola.students WHERE id=p_student FOR UPDATE;\n v_now:=clock_timestamp();\n INSERT INTO decola.trial_claims(eligibility_key,student_id,starts_at,ends_at)\n VALUES(v_key,p_student,v_now,v_now+interval '168 hours')\n ON CONFLICT(eligibility_key,product) DO NOTHING;\n SELECT * INTO v_record FROM decola.trial_claims WHERE eligibility_key=v_key AND product='decola-monthly-v1';\n RETURN jsonb_build_object('startsAt',v_record.starts_at,'endsAt',v_record.ends_at,'canceledAt',v_record.canceled_at);\nEND;\n$function$\n",
        "owner_bypassrls": true,
        "security_definer": true
      },
      {
        "acl": [
          "postgres=X/postgres",
          "authenticated=X/postgres"
        ],
        "owner": "postgres",
        "settings": [
          "search_path=\"\""
        ],
        "signature": "decola.cancel_trial(uuid)",
        "definition": "CREATE OR REPLACE FUNCTION decola.cancel_trial(p_student uuid)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nBEGIN\n PERFORM decola.assert_student(p_student);\n PERFORM 1 FROM decola.students WHERE id=p_student FOR UPDATE;\n UPDATE decola.trial_claims SET canceled_at=coalesce(canceled_at,clock_timestamp()) WHERE student_id=p_student;\nEND;\n$function$\n",
        "owner_bypassrls": true,
        "security_definer": true
      },
      {
        "acl": [
          "postgres=X/postgres",
          "authenticated=X/postgres"
        ],
        "owner": "postgres",
        "settings": [
          "search_path=\"\""
        ],
        "signature": "decola.can_study(uuid)",
        "definition": "CREATE OR REPLACE FUNCTION decola.can_study(p_student uuid)\n RETURNS boolean\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE v_now timestamptz:=clock_timestamp();\nBEGIN\n PERFORM decola.assert_student(p_student);\n RETURN EXISTS(SELECT 1 FROM decola.trial_claims t WHERE t.student_id=p_student AND t.canceled_at IS NULL AND t.starts_at<=v_now AND t.ends_at>v_now)\n OR EXISTS(SELECT 1 FROM decola.paid_periods p WHERE p.student_id=p_student AND p.revoked_at IS NULL AND p.starts_at<=v_now AND p.ends_at>v_now);\nEND;\n$function$\n",
        "owner_bypassrls": true,
        "security_definer": true
      }
    ],
